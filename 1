<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PROFILE - 唐择镇</title>
    <style>
        :root {
            --paper-white: #f5f5f7;
            --accent-red: #ff3b30;
            --text-dim: #86868b;
            --black: #1d1d1f;
        }

        /* 继承原有基础样式 */
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body {
            background-color: #0a0b10; 
            color: var(--black);
            font-family: -apple-system, "SF Pro SC", "SF Pro Display", sans-serif;
            height: 100vh; overflow: hidden;
            display: flex; justify-content: center; align-items: center;
            perspective: 2000px;
        }

        /* 背景粒子继承 */
        .particles { position: fixed; width: 100%; height: 100%; pointer-events: none; z-index: 0; transform-style: preserve-3d; }
        .dot { position: absolute; background: white; border-radius: 50%; opacity: 0.2; animation: twinkle var(--duration) infinite ease-in-out; }
        @keyframes twinkle { 0%, 100% { opacity: 0.1; transform: translateZ(var(--z)) scale(0.8); } 50% { opacity: 0.6; transform: translateZ(var(--z)) scale(1.2); } }

        /* 卡片框架 */
        .poster-frame {
            position: relative; width: 85%; max-width: 380px; aspect-ratio: 3 / 4.2;
            background: var(--paper-white); 
            box-shadow: 0 40px 80px rgba(0,0,0,0.6);
            padding: 25px; display: flex; flex-direction: column;
            z-index: 10; transition: transform 0.4s cubic-bezier(0.2, 0, 0.2, 1);
        }

        /* 头部样式 */
        .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; }
        .back-btn { font-size: 10px; font-weight: 800; color: var(--accent-red); text-decoration: none; border: 1px solid var(--accent-red); padding: 2px 6px; transition: 0.3s; }
        .back-btn:hover { background: var(--accent-red); color: white; }
        
        /* 个人详情内容区 */
        .content-scroll {
            flex-grow: 1; overflow-y: auto; overflow-x: hidden;
            padding-right: 5px; margin-bottom: 15px;
        }
        /* 自定义滚动条 */
        .content-scroll::-webkit-scrollbar { width: 2px; }
        .content-scroll::-webkit-scrollbar-thumb { background: var(--accent-red); }

        .bio-title { font-size: 24px; font-weight: 900; margin-bottom: 5px; letter-spacing: -1px; }
        .bio-tag { font-size: 10px; color: var(--text-dim); margin-bottom: 20px; letter-spacing: 2px; }
        
        .section-label { font-size: 9px; font-weight: 800; color: var(--accent-red); margin-bottom: 10px; text-transform: uppercase; border-bottom: 1px solid #ddd; padding-bottom: 4px; }
        
        .info-p { font-size: 13px; line-height: 1.6; color: #444; margin-bottom: 20px; text-align: justify; }

        /* 技能条样式 */
        .skill-item { margin-bottom: 12px; }
        .skill-info { display: flex; justify-content: space-between; font-size: 10px; font-weight: 700; margin-bottom: 4px; }
        .skill-bar { height: 2px; background: #e0e0e0; width: 100%; }
        .skill-progress { height: 100%; background: var(--accent-red); width: 0; transition: width 1.5s ease-out; }

        /* 履历样式 */
        .exp-item { margin-bottom: 10px; position: relative; padding-left: 12px; }
        .exp-item::before { content: ''; position: absolute; left: 0; top: 5px; width: 4px; height: 4px; background: var(--accent-red); }
        .exp-date { font-size: 9px; font-family: monospace; color: var(--text-dim); }
        .exp-name { font-size: 12px; font-weight: 700; }

        .footer-status { display: flex; justify-content: space-between; border-top: 1px solid #eee; padding-top: 15px; font-size: 10px; font-weight: 700; }
        .time-code { font-family: monospace; color: var(--accent-red); }
    </style>
</head>
<body>

    <div class="particles" id="particles"></div>

    <div class="scene" id="scene">
        <div class="poster-frame" id="poster">
            <div class="header">
                <a href="javascript:history.back()" class="back-btn">RETURN</a>
                <div class="time-code" id="time-code">00:00:00:00</div>
            </div>

            <div class="content-scroll">
                <h1 class="bio-title">唐择镇</h1>
                <p class="bio-tag">VISUAL DESIGNER / ARTIST</p>

                <div class="section-label">Profile / 简介</div>
                <p class="info-p">
                    致力于探索媒体与空间的边界。通过实验性的视觉语言，重构感官体验。
                </p>

                <div class="section-label">Skills / 技能</div>
                <div class="skill-item">
                    <div class="skill-info"><span>UI/UX DESIGN</span><span>90%</span></div>
                    <div class="skill-bar"><div class="skill-progress" style="width: 90%;"></div></div>
                </div>
                <div class="skill-item">
                    <div class="skill-info"><span>MOTION GRAPHICS</span><span>85%</span></div>
                    <div class="skill-bar"><div class="skill-progress" style="width: 85%;"></div></div>
                </div>
                <div class="skill-item">
                    <div class="skill-info"><span>FRONT-END DEV</span><span>70%</span></div>
                    <div class="skill-bar"><div class="skill-progress" style="width: 70%;"></div></div>
                </div>

                <div style="margin-top: 20px;" class="section-label">Experience / 履历</div>
                <div class="exp-item">
                    <div class="exp-date">2025 - PRESENT</div>
                    <div class="exp-name">MFA 研究生在读 / 戏剧与影视</div>
                </div>
                <div class="exp-item">
                    <div class="exp-date">2021 - 2023</div>
                    <div class="exp-name">自由摄影师 / 独立工作室</div>
                </div>
            </div>

            <div class="footer-status">
                <div>DOC.TYPE: PERSONAL_PROFILE</div>
                <div style="color: var(--accent-red)">VER 2.0.26</div>
            </div>
        </div>
    </div>

    <script>
        const poster = document.getElementById('poster');
        let targetX = 0, targetY = 0;
        let currentX = 0, currentY = 0;

        // 维持原有的3D视差效果
        window.addEventListener('mousemove', (e) => {
            targetX = (e.clientX / window.innerWidth - 0.5) * 30;
            targetY = (e.clientY / window.innerHeight - 0.5) * 30;
        });

        function updateParallax() {
            currentX += (targetX - currentX) * 0.1;
            currentY += (targetY - currentY) * 0.1;
            poster.style.transform = `rotateY(${currentX}deg) rotateX(${-currentY}deg)`;
            requestAnimationFrame(updateParallax);
        }
        updateParallax();

        // 时间戳逻辑
        setInterval(() => {
            const now = new Date();
            const h = String(now.getHours()).padStart(2, '0');
            const m = String(now.getMinutes()).padStart(2, '0');
            const s = String(now.getSeconds()).padStart(2, '0');
            const ms = String(Math.floor(now.getMilliseconds() / 10)).padStart(2, '0');
            document.getElementById('time-code').textContent = `${h}:${m}:${s}:${ms}`;
        }, 40);

        // 粒子背景逻辑
        const partContainer = document.getElementById('particles');
        for(let i=0; i<60; i++) {
            const dot = document.createElement('div');
            dot.className = 'dot';
            const size = Math.random() * 2;
            dot.style.cssText = `width:${size}px; height:${size}px; left:${Math.random()*100}%; top:${Math.random()*100}%; --z:${Math.random()*1000-500}px; --duration:${2+Math.random()*3}s;`;
            partContainer.appendChild(dot);
        }
    </script>
</body>
</html>